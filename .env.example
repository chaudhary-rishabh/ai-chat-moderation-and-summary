# Database
DATABASE_URL=postgresql://user:password@localhost:5432/chatapp
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=<32-char minimum random string>
JWT_REFRESH_SECRET=<32-char minimum random string>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
NEXTAUTH_SECRET=<32-char minimum random string>
NEXTAUTH_URL=http://localhost:3000

# Admin app
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Backend
SERVER_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
SERVER_URL=http://localhost:4000
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Email (nodemailer for forgot-password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@chatapp.com

# App
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRY_MINUTES=30
